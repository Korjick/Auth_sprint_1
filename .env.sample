PROJECT_NAME=auth

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=auth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TEST_POSTGRES_PASSWORD

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

JWT_SECRET_KEY=TEST_JWT_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=2

LOG_JSON=true
LOG_LEVEL=INFO

OTEL_ENABLED=true
OTEL_SERVICE_NAME=auth-api
OTEL_SERVICE_VERSION=0.1.0
OTEL_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_EXPORTER_OTLP_INSECURE=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_API_IP_LIMIT=300
RATE_LIMIT_API_IP_WINDOW_SEC=60
RATE_LIMIT_SIGNUP_IP_LIMIT=10
RATE_LIMIT_SIGNUP_IP_WINDOW_SEC=60
RATE_LIMIT_LOGIN_IP_LIMIT=30
RATE_LIMIT_LOGIN_IP_WINDOW_SEC=60
RATE_LIMIT_LOGIN_KEY_IP_LIMIT=5
RATE_LIMIT_LOGIN_KEY_IP_WINDOW_SEC=60
RATE_LIMIT_REFRESH_USER_LIMIT=30
RATE_LIMIT_REFRESH_USER_WINDOW_SEC=60

OAUTH_STATE_TTL_SEC=300
OAUTH_GOOGLE_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/oauth/google/callback
OAUTH_GOOGLE_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
OAUTH_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
OAUTH_GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
OAUTH_GOOGLE_SCOPES=openid email profile
OAUTH_GOOGLE_ISSUER_PRIMARY=https://accounts.google.com
OAUTH_GOOGLE_ISSUER_SECONDARY=accounts.google.com
OAUTH_GOOGLE_HTTP_TIMEOUT_SEC=5.0
